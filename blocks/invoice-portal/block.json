{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wm/peppol-invoice-portal",
  "version": "1.1.0",
  "title": "Peppol-Rechnungsstatus-Portal",
  "category": "widgets",
  "icon": "media-spreadsheet",
  "description": "Öffentliches Statusportal zur Abfrage gespeicherter Peppol-E-Rechnungen anhand von Rechnungsnummer und Peppol-ID.",
  "keywords": [
    "peppol",
    "invoice",
    "e-rechnung",
    "ubl",
    "status"
  ],
  "textdomain": "wm-peppol-as4-gateway",
  "attributes": {
    "showHeading": {
      "type": "boolean",
      "default": true
    },
    "showLead": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "wm-peppol-blocks-editor",
  "style": "wm-peppol-portal"
}
