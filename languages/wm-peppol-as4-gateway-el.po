msgstr "Το σώμα του αιτήματος πρέπει να είναι αντικείμενο JSON."

#. translators: %d: row id
#: includes/AS4/DeliveryRegister.php:135
#, php-format
msgid ""
"Zeile %d verweist nicht auf die Zeile davor: eine Zeile wurde entfernt oder "
