msgstr "Peppol: E-factuur %s aangemaakt; verzending is ingepland."

#. translators: %s: invoice number
#: includes/WooCommerce/WooCommerceInvoiceHook.php:164
#, php-format
msgid ""
"Peppol: E-Rechnung %s erzeugt und gespeichert, nicht versendet: KoSIT-"
"Validator und Phase4-Dienst sind nicht konfiguriert."
msgstr ""
"Peppol: E-factuur %s aangemaakt en opgeslagen, niet verzonden: KoSIT-"
"validator en Phase4-dienst zijn niet geconfigureerd."

#. translators: 1: number of fatal findings, 2: rule identifiers
#: includes/WooCommerce/WooCommerceInvoiceHook.php:207
#, php-format
msgid "EN 16931: %1$d fatale Regelbefunde (%2$s)."
msgstr "EN 16931: %1$d fatale regelbevindingen (%2$s)."

#. translators: 1: number of fatal findings, 2: rule identifiers
#: includes/WooCommerce/WooCommerceInvoiceHook.php:219
#, php-format
msgid ""
"Peppol: Die EN-16931-Regelprüfung meldet %1$d fatale Befunde (%2$s). "
"Versendet wird trotzdem; zum Blockieren \"wm_peppol_schematron_gate\" auf 1 "
"setzen."
msgstr ""
"Peppol: De EN 16931-regelcontrole meldt %1$d fatale bevindingen (%2$s). "
"Verzending gaat toch door; zet \"wm_peppol_schematron_gate\" op 1 om te "
"blokkeren."

#. translators: 1: invoice number, 2: message id
#: includes/WooCommerce/WooCommerceInvoiceHook.php:262
#, php-format
msgid ""
"Peppol: E-Rechnung %1$s an den Phase4-Dienst übergeben (messageId %2$s). "
"Zugestellt ist sie erst mit der Empfangsquittung."
msgstr ""
"Peppol: E-factuur %1$s overgedragen aan Phase4-dienst (messageId %2$s). "
"Aflevering staat pas vast na ontvangstbewijs."

#: includes/WooCommerce/WooCommerceInvoiceHook.php:309
