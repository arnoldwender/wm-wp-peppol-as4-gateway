msgid "WM Peppol AS4 Gateway"
msgstr ""

#. Plugin URI of the plugin
#: wm-peppol-as4-gateway.php
msgid "https://arnoldwender.com/wordpress-plugins/wm-peppol-as4-gateway/"
msgstr ""

#. Description of the plugin
#: wm-peppol-as4-gateway.php
msgid "Erzeugt UBL-2.1-Rechnungen nach Peppol BIS Billing 3.0, prüft sie gegen das amtliche EN-16931-Regelwerk, sucht den Empfänger über SML und SMP, übergibt Rechnungen abgeschlossener WooCommerce-Bestellungen an einen konfigurierten KoSIT-Validator und Phase4-Dienst, prüft die signierte AS4-Quittung und zeigt Käufern den gespeicherten Status. Keine eigene AS4-Übertragung: die übernimmt der Phase4-Dienst."
msgstr ""

#. Author of the plugin
#: wm-peppol-as4-gateway.php
msgid "Arnold Wender"
msgstr ""

#. Author URI of the plugin
#: wm-peppol-as4-gateway.php
msgid "https://arnoldwender.com"
msgstr ""

