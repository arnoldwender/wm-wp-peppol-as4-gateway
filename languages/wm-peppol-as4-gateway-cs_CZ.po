"certifikátů přístupového bodu. Přednost má konstanta "
"WM_PEPPOL_TRUSTED_SIGNER_SHA256 v souboru wp-config.php."

#: includes/Admin/AdminDashboard.php:733
msgid "Lokales CA-Zertifikatsbündel im PEM-Format (OpenPeppol-PKI, optional)"
msgstr "Místní balík certifikátů CA ve formátu PEM (PKI OpenPeppol, volitelné)"

#: includes/Admin/AdminDashboard.php:735
msgid ""
