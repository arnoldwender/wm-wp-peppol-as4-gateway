{
    "name": "arnoldwender/wm-peppol-as4-gateway",
    "description": "PEPPOL AS4 gateway for electronic invoicing.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "WMCyber\\Peppol\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WMCyber\\Peppol\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
